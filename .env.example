# Database (PostgreSQL + pgvector extension harus aktif)
DATABASE_URL=postgresql://user:password@localhost:5432/diajar_db

# NextAuth
AUTH_SECRET=generate-dengan-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# AI generation (jawaban Q&A) — provider OpenAI-compatible, mis. Sumopod.
# Model bisa diganti-ganti tanpa ubah kode (deepseek-chat, gpt-4o-mini, dll).
AI_BASE_URL=https://ai.sumopod.com/v1
AI_API_KEY=sk-xxxxx
AI_MODEL=deepseek-chat

# AI embedding (retrieval RAG) — HARUS konsisten, dimensi cocok dengan schema.
# Kalau tidak diisi, ikut AI_* di atas. text-embedding-3-small = 1536 dimensi.
EMBEDDING_BASE_URL=https://ai.sumopod.com/v1
EMBEDDING_API_KEY=sk-xxxxx
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# YouTube Data API (untuk ambil metadata & transcript video)
YOUTUBE_API_KEY=xxxxx
